rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper security functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isOwner() {
      return hasRole('owner');
    }

    function isManager() {
      return hasRole('manager') || isOwner();
    }

    function isEmployee() {
      return hasRole('employee') || isManager();
    }

    // 1. Users collection: Customer profiles & staff records
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isManager());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isOwner());
      allow delete: if isOwner();
    }

    // 2. Menu Items collection: Public read, manager write
    match /menuItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isManager();
    }

    // 3. Orders collection: Customer read own, staff read/update all
    match /orders/{orderId} {
      allow read: if isEmployee() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if true; // Direct website guest checkout & registered customers
      allow update: if isEmployee();
      allow delete: if isOwner();
    }

    // 4. Inventory collection: Employee read stock, manager edit/adjust
    match /inventory/{ingId} {
      allow read: if isEmployee();
      allow create, update, delete: if isManager();
    }

    // 5. Purchases collection: Manager & Owner only
    match /purchases/{purchaseId} {
      allow read: if isManager();
      allow create, update: if isManager();
      allow delete: if isOwner();
    }

    // 6. Expenses collection: Financials protected from employees
    match /expenses/{expenseId} {
      allow read, create, update: if isManager();
      allow delete: if isOwner();
    }

    // 7. Customers & Marketing retention: Manager & Owner
    match /customers/{customerId} {
      allow read, write: if isManager();
    }

    // 8. Customer Feedback: Public submit, Manager review
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isManager();
    }

    // 9. System Settings: Public read (hours/taxes), Owner write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}

